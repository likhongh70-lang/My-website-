  else if(a==='pimgdel'){const p=byId[id];if(p&&p.imgs){p.imgs.splice(+t.dataset.i,1);if(!p.imgs.length)delete p.imgs;saveProducts();refresh();keepScroll()}}
  else if(a==='pcover'){const p=byId[id],i=+t.dataset.i;if(p&&p.imgs&&i>0){const [u]=p.imgs.splice(i,1);p.imgs.unshift(u);saveProducts();refresh();keepScroll()}}
  else if(a==='pvdel'){const p=byId[id];if(p){if(p.vid==='file'){vdel('p'+p.id).catch(()=>{});if(VURL[p.id]){URL.revokeObjectURL(VURL[p.id]);delete VURL[p.id]}}delete p.vid;saveProducts();refresh();keepScroll();toast('Video removed')}}
  else if(a==='page'){const n=+t.dataset.p;if(n>=1){pg=n;renderGrid();const sh=document.getElementById('shopT');if(sh)sh.scrollIntoView({behavior:'smooth',block:'start'})}}
  else if(a==='publish'){publishAll()}
