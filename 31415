    else{toast(ordersWith(cur.id).length?'You have already rated this product':'Buy this product first to rate it');const mr=document.querySelector('.m-rev');if(mr)mr.scrollIntoView({block:'center'})}
  }
  else if(a==='rcancel'){revOpen=false;revStars=0;revText='';revImgs=[];renderModal()}
  else if(a==='rimgdel'){revImgs.splice(+t.dataset.i,1);renderModal()}
  else if(a==='lb'){const r=reviews.find(x=>x.id===t.dataset.r);if(r&&r.imgs){$('#lb img').src=r.imgs[+t.dataset.i];$('#lb').hidden=false}}
  else if(a==='lbclose'){$('#lb').hidden=true}
  else if(a==='rstar'){revStars=+t.dataset.n;renderModal()}
  else if(a==='rsubmit'){
    if(!revStars){toast('Choose a star rating first');return}
    const ro=reviewOrder(cur.id);if(!ro){toast('Only customers who bought this product can review it');return}
    const rv={id:'r'+Date.now(),pid:cur.id,orderId:ro.id,name:dispName(ro.name),stars:revStars,text:revText.trim(),at:Date.now()};
    if(revImgs.length)rv.imgs=revImgs.slice();
    reviews.push(rv);
    if(!saveReviews()){reviews.pop();return}
    revOpen=false;revStars=0;revText='';revImgs=[];refresh();renderModal();toast('Thanks for your review');
  }
  else if(a==='rev'){closeAll();openModal(id);revOpen=true;renderModal();const fm=$('#revForm');if(fm)fm.scrollIntoView({block:'center'})}
  else if(a==='rdel'){reviews=reviews.filter(r=>r.id!==t.dataset.rid);saveReviews();refresh();keepScroll()}
  else if(a==='preset'){
    if(!confirmReset){confirmReset=true;keepScroll()}
    else{confirmReset=false;P=copyDef();reindex();for(const x of Object.keys(cart))if(!byId[pidOf(x)])delete cart[x];wish=new Set([...wish].filter(x=>byId[x]));saveProducts();persist();refresh();keepScroll();toast('Sample products restored')}
  }
  else if(a==='oimport'){const ta=$('#impTxt');if(ta){importOrder(ta.value);ta.value='';renderDrawer()}}
  else if(a==='odel'){orders=orders.filter(o=>o.id!==t.dataset.oid);saveOrders();refresh();renderDrawer()}
  else if(a==='cart')openDrawer('cart');
  else if(a==='inc'){const p=byId[pidOf(k)];if(p&&p.stock!=null&&qtyIn(p.id)+1>p.stock){toast(`Only ${p.stock} in stock`);return}cart[k]++;persist();renderCounts();renderDrawer()}
  else if(a==='dec'){cart[k]--;if(cart[k]<=0)delete cart[k];persist();renderCounts();renderDrawer()}
  else if(a==='rm'){delete cart[k];persist();renderCounts();renderDrawer()}
  else if(a==='capply'){
    const v=(($('#cpn')||{}).value||'').trim();
    if(!v){toast('Enter a coupon code');return}
    const c=findCoupon(v);
    if(!c){toast('Invalid or expired coupon');return}
    if(subtotal()<(+c.min||0)){toast(`Minimum order ${fmt(c.min)} for this coupon`);return}
    couponCode=c.code;toast(`Coupon ${c.code.toUpperCase()} applied`);renderDrawer();
  }
  else if(a==='cclear'){couponCode='';renderDrawer()}
  else if(a==='checkout'){step='checkout';renderDrawer();const n=$('#cName');if(n)n.focus()}
  else if(a==='back'){step='cart';renderDrawer()}
  else if(a==='close')closeAll();
  else if(a==='minc'){mq=Math.min(10,mq+1);renderModal()}
  else if(a==='mdec'){mq=Math.max(1,mq-1);renderModal()}
  else if(a==='madd'){const v=pickedVariant();if(v===null)return;if(addToCart(cur,mq,v)){closeAll();toast('Added to cart')}}
  else if(a==='buy'){const v=pickedVariant();if(v===null)return;if(addToCart(cur,mq,v))openDrawer('checkout')}
});

/* ---------- field changes ---------- */
document.addEventListener('change',e=>{
  const el=e.target;
  if(el.id==='cDist')updateTotals();
  if(el.id==='revFile'){
    const files=[...(el.files||[])],room=3-revImgs.length;
    if(!files.length||room<=0)return;
    if(files.length>room)toast('Up to 3 photos per review');
    Promise.all(files.slice(0,room).map(x=>new Promise(res=>resizeImg(x,res)))).then(us=>{revImgs=revImgs.concat(us.filter(Boolean));renderModal();const fm=$('#revForm');if(fm)fm.scrollIntoView({block:'center'})});
    return;
  }
  if(el.id==='bnrOn'){settings.site.bnrOff=el.checked?'':'1';saveSettings();applySite();return}
  if(el.id==='bnrFile'){
    const f=el.files&&el.files[0];if(!f)return;
    const r=new FileReader();
    r.onload=()=>{const im=new Image();
      im.onload=()=>{const W=im.width||1200,H=im.height||400,k=Math.min(1,1200/W);const c=document.createElement('canvas');c.width=Math.max(1,Math.round(W*k));c.height=Math.max(1,Math.round(H*k));const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(im,0,0,c.width,c.height);
        const old=settings.site.bnrImg;settings.site.bnrImg=c.toDataURL('image/jpeg',.82);
        try{localStorage.setItem('haat-settings',JSON.stringify(settings))}catch(err){settings.site.bnrImg=old;toast('Banner image is too large');return}
        applySite();keepScroll();toast('Banner changed')};
      im.onerror=()=>toast('Could not read that image');im.src=r.result};
    r.readAsDataURL(f);return;
  }
  if(el.id==='logoFile'){
    const f=el.files&&el.files[0];if(!f)return;
    const r=new FileReader();
    r.onload=()=>{const im=new Image();
      im.onload=()=>{const W=im.width||300,H=im.height||300,k=Math.min(1,300/Math.max(W,H));const c=document.createElement('canvas');c.width=Math.max(1,Math.round(W*k));c.height=Math.max(1,Math.round(H*k));c.getContext('2d').drawImage(im,0,0,c.width,c.height);
        const old=settings.site.logo;settings.site.logo=c.toDataURL('image/png');
        try{localStorage.setItem('haat-settings',JSON.stringify(settings))}catch(err){settings.site.logo=old;toast('Logo is too large');return}
        applySite();keepScroll();toast('Logo changed')};
      im.onerror=()=>toast('Could not read that image');im.src=r.result};
    r.readAsDataURL(f);return;
  }
  const ds=el.dataset||{};
  if(ds.s){
    const D=settings.delivery;
    if(ds.s==='site'){settings.site[ds.k]=el.value.trim();saveSettings();applySite();return}
    if(ds.s==='dhaka'||ds.s==='other'||ds.s==='freeOver'){D[ds.s]=Math.max(0,Math.round(+el.value)||0)}
    else if(ds.s==='fee'){if(el.value==='')delete D.fees[ds.d];else D.fees[ds.d]=Math.max(0,Math.round(+el.value)||0)}
    else if(ds.s==='cpn'){
      const c=settings.coupons[+ds.i];if(!c)return;
      if(ds.f==='code'){const v=el.value.trim().toUpperCase().replace(/\s+/g,'');if(v)c.code=v}
      else if(ds.f==='type')c.type=el.value;
      else if(ds.f==='on')c.on=el.checked;
      else c[ds.f]=Math.max(0,Math.round(+el.value)||0);
    }
    saveSettings();renderTiles();keepScroll();
    return;
  }
  if(ds.pid){
    const p=byId[ds.pid];if(!p)return;
    const fl=ds.f,v=el.value;
    if(fl==='img'){
      const files=[...(el.files||[])];if(!files.length)return;
      const room=6-(p.imgs||[]).length;
      if(room<=0){toast('Up to 6 photos per product');return}
      if(files.length>room)toast('Only 6 photos per product. Extra photos were skipped.');
      Promise.all(files.slice(0,room).map(x=>new Promise(res=>resizeImg(x,res)))).then(urls=>{
        const old=(p.imgs||[]).slice();p.imgs=old.concat(urls.filter(Boolean));
        if(!saveProducts()){if(old.length)p.imgs=old;else delete p.imgs}
        refresh();keepScroll();
      });
      return;
    }
    if(fl==='video'){
      const fv=el.files&&el.files[0];if(!fv)return;
      if(!/^video\//.test(fv.type)){toast('Please choose a video file');return}
      if(fv.size>20*1024*1024){toast('Video is too large. Max 20 MB.');return}
      (async()=>{
        let A=null;try{A=window.claude?await window.claude.use('assets'):null}catch(e){}
        try{
          if(A){toast('Uploading video…');const r=await A.upload(fv);p.vid='url:'+r.url}
          else{await vput('p'+p.id,fv);if(VURL[p.id])URL.revokeObjectURL(VURL[p.id]);VURL[p.id]=URL.createObjectURL(fv);p.vid='file'}
          saveProducts();refresh();keepScroll();toast(A?'Video added. Tap Publish to show it on all phones.':'Video added (this phone only)');
        }catch(err){toast('Could not save the video')}
      })();
      return;
    }
    if(fl==='vurl'){
      const u=v.trim();
      if(!u){if(p.vid&&String(p.vid).startsWith('url:')){delete p.vid;saveProducts();refresh();keepScroll()}return}
      if(!/^https?:\/\//i.test(u)){toast('Link must start with https://');return}
      if(p.vid==='file')vdel('p'+p.id).catch(()=>{});
      p.vid='url:'+u;saveProducts();refresh();keepScroll();toast('Video link saved');return;
    }
    if(fl==='name'){if(v.trim())p.name=v.trim()}
    else if(fl==='price'){p.price=Math.max(1,Math.round(+v)||1)}
    else if(fl==='was'){let w=Math.max(0,Math.round(+v)||0);if(w&&w<=p.price){toast('Old price must be higher than the price');w=0}p.was=w}
    else if(fl==='cat'){p.cat=v}
    else if(fl==='stock'){p.stock=v===''?null:Math.max(0,Math.round(+v)||0)}
    else if(fl==='desc'){p.desc=v.trim();if(!p.desc)delete p.desc}
    else if(fl==='opts'){const o=parseOpts(v);if(o.length)p.opts=o;else delete p.opts}
    saveProducts();refresh();keepScroll();
    return;
  }
  if(ds.oid){const o=orders.find(x=>x.id===ds.oid);if(o){setStatus(o,el.value);saveOrders();refresh();keepScroll()}}
});
