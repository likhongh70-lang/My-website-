const tmap=new WeakMap(),amap=new WeakMap();
function trText(s){
  if(Object.prototype.hasOwnProperty.call(BN,s))return BN[s];
  for(const [rx,fn] of BNRX){const m=rx.exec(s);if(m)return fn(...m.slice(1))}
  return null;
}
function trNode(n){
  const rec=tmap.get(n),cur=n.nodeValue;
  if(rec&&cur===rec.bn){if(lang!=='bn'){n.nodeValue=rec.en;tmap.delete(n)}return}
  if(lang!=='bn')return;
  const core=cur.trim();if(!core)return;
  const bn=trText(core);if(bn==null)return;
  const out=cur.replace(core,()=>bn);
  tmap.set(n,{en:cur,bn:out});n.nodeValue=out;
}
function trAttrs(el){
  for(const a of ['placeholder','aria-label','title']){
    if(!el.hasAttribute(a))continue;
    let rec=amap.get(el);if(!rec){rec={};amap.set(el,rec)}
    const r=rec[a],cur=el.getAttribute(a);
    if(r&&cur===r.bn){if(lang!=='bn'){el.setAttribute(a,r.en);delete rec[a]}continue}
    if(lang!=='bn')continue;
    const bn=trText(cur.trim());if(bn==null)continue;
    rec[a]={en:cur,bn};el.setAttribute(a,bn);
  }
}
function trAll(root){
  const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:n=>{const p=n.parentElement;return p&&!/^(SCRIPT|STYLE|TEXTAREA|TITLE)$/.test(p.tagName)?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT}});
  const nodes=[];for(let n;n=w.nextNode();)nodes.push(n);
  nodes.forEach(trNode);
  root.querySelectorAll('[placeholder],[aria-label],[title]').forEach(trAttrs);
}
let trQueued=false;
const mo=new MutationObserver(()=>{if(trQueued)return;trQueued=true;requestAnimationFrame(()=>{trQueued=false;translateAll()})});
function translateAll(){
  mo.disconnect();
  try{trAll(document.body)}finally{mo.observe(document.body,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:['placeholder','aria-label','title']})}
}
function setLang(l){
  lang=l;try{localStorage.setItem('haat-lang',l)}catch(e){}
  document.documentElement.lang=l==='bn'?'bn':'en';
  $('#langBtn').textContent=l==='bn'?'EN':'বাংলা';
  translateAll();
}

