/* ---------- cart maths: stock, coupon, delivery ---------- */
const lines=()=>Object.entries(cart).map(([k,q])=>({k,p:byId[pidOf(k)],q,v:varOf(k)})).filter(l=>l.p);
const subtotal=()=>lines().reduce((s,l)=>s+l.p.price*l.q,0);
