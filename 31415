<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Zuvant</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Hind+Siliguri:wght@400;600&display=swap" rel="stylesheet">
<style>
/* Layout: sticky utility header, 11.11 countdown hero beside promise tiles, category chips, flash-sale rail, filterable grid; cart + checkout in a side drawer, product detail in a modal. */
:root{
  --bg:#F4F4F4; --surface:#FFFFFF; --ink:#212121; --muted:#6F6F6F; --line:#E6E6E6;
  --accent:#E14C07; --accent-ink:#FFFFFF; --chip:#FFF0E8; --sale:#E5383B; --gold:#FFB400;
  --hero-bg:#FF6A1F; --hero-bg2:#F0386B; --hero-ink:#FFFFFF; --strip:#2B2B2B; --voucher:#FFF4EE; --shadow:0 10px 40px rgba(0,0,0,.18);
  --display:"DM Sans","Hind Siliguri",system-ui,sans-serif;
  --body:"DM Sans","Hind Siliguri",system-ui,sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#121212; --surface:#1E1E1E; --ink:#EEEEEE; --muted:#A3A3A3; --line:#333333;
  --accent:#FF8A50; --accent-ink:#2A1200; --chip:#2E2018; --sale:#FF7A7A; --hero-bg:#C2410C; --hero-bg2:#9D174D; --voucher:#2A1E17; --strip:#000000; --shadow:0 10px 40px rgba(0,0,0,.5); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#121212; --surface:#1E1E1E; --ink:#EEEEEE; --muted:#A3A3A3; --line:#333333;
  --accent:#FF8A50; --accent-ink:#2A1200; --chip:#2E2018; --sale:#FF7A7A; --hero-bg:#C2410C; --hero-bg2:#9D174D; --voucher:#2A1E17; --strip:#000000; --shadow:0 10px 40px rgba(0,0,0,.5); color-scheme:dark}

*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 var(--body)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--surface);z-index:30}
h1,h2,h3,p{margin:0}
h1,h2{font-family:var(--display);text-wrap:balance}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.in{max-width:1240px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.num{font-variant-numeric:tabular-nums}

/* header */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--surface);border-bottom:1px solid var(--line)}
.top .in{display:grid;grid-template-columns:auto 1fr auto;gap:12px 20px;align-items:center;padding-block:10px}
.brand{font-family:var(--display);font-weight:800;font-size:1.55rem;letter-spacing:-.02em;color:var(--accent);text-decoration:none;display:flex;align-items:center;gap:8px}
.brand i{display:inline-block;width:26px;height:26px;border-radius:7px 7px 13px 13px;background:var(--gold);position:relative}
.brand i::after{content:"";position:absolute;left:5px;right:5px;top:-6px;height:10px;border:3px solid var(--accent);border-bottom:0;border-radius:8px 8px 0 0}
.search{display:flex;min-width:0;border:2px solid var(--accent);border-radius:8px;overflow:hidden;background:var(--bg)}
.search input{flex:1;min-width:0;border:0;background:transparent;padding:9px 12px;outline:0}
.search:focus-within{box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 30%,transparent)}
.search button{border:0;background:var(--accent);color:var(--accent-ink);padding:0 16px;font-weight:700}
.acts{display:flex;gap:6px}
.ibtn{display:flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 12px;font-weight:500}
.ibtn[aria-pressed="true"]{background:var(--chip);border-color:var(--accent)}
.ibtn b{background:var(--sale);color:#fff;border-radius:10px;min-width:20px;padding:0 6px;font-size:.78rem;text-align:center;line-height:20px}
.ibtn svg{width:18px;height:18px}
@media (max-width:720px){.top .in{grid-template-columns:1fr auto}.search{grid-column:1/-1;order:3}.ibtn span{display:none}}

/* chips */
.chips{display:flex;gap:8px;overflow-x:auto;padding-block:14px;scrollbar-width:thin}
.chip{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:6px 16px;font-weight:500}
.chip[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* hero */
.hero{display:grid;grid-template-columns:2fr 1fr;gap:14px;padding-block:4px 8px}
.hero-main{background:var(--hero-bg);color:var(--hero-ink);border-radius:14px;padding:clamp(20px,4vw,40px);position:relative;overflow:hidden;min-width:0}
.hero-main::after{content:"11.11";position:absolute;right:-10px;bottom:-34px;font:800 clamp(7rem,20vw,13rem)/1 var(--display);color:transparent;-webkit-text-stroke:2px rgba(242,178,48,.28);pointer-events:none}
.eyebrow{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--gold)}
.hero h1{font-size:clamp(2rem,5.4vw,3.5rem);line-height:1.02;font-weight:800;margin:8px 0 10px;max-width:14ch}
.hero h1 em{font-style:normal;color:var(--gold)}
.hero-main p{max-width:44ch;opacity:.88}
.cds{display:flex;gap:8px;margin:20px 0;position:relative;z-index:1}
.cd{background:rgba(255,255,255,.12);border-radius:8px;padding:8px 0;width:64px;text-align:center}
.cd b{display:block;font:800 1.5rem/1.1 var(--display)}
.cd span{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;opacity:.8}
.btn{border:0;border-radius:8px;background:var(--accent);color:var(--accent-ink);padding:11px 20px;font-weight:700;text-decoration:none;display:inline-block}
.btn.gold{background:var(--gold);color:#2B1F00;position:relative;z-index:1}
.btn.line{background:transparent;color:var(--accent);border:1.5px solid var(--accent)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.hero-side{display:grid;gap:14px}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px;min-width:0}
.tile h3{font:700 1rem var(--display)}
.tile p{color:var(--muted);font-size:.9rem;margin-top:2px}
@media (max-width:860px){.hero{grid-template-columns:1fr}.hero-side{grid-template-columns:1fr 1fr 1fr}}
@media (max-width:640px){.hero-side{grid-template-columns:1fr}}

/* sections */
.sec{padding-block:22px 6px}
.sec-h{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.sec-h h2{font-size:1.4rem;font-weight:800}
.sec-h small{color:var(--muted)}
.flash-h h2{color:var(--sale)}
.rail{display:flex;gap:12px;overflow-x:auto;padding-bottom:10px;scroll-snap-type:x proximity}
.rail .card{flex:none;width:176px;scroll-snap-align:start}
.cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px}
.cat{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 8px 12px;text-align:center;font-weight:500}
.cat svg{width:64px;height:64px;border-radius:50%;display:block;margin:0 auto 6px}

/* filters */
.bar{display:flex;gap:14px 24px;flex-wrap:wrap;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin-bottom:14px}
.bar label{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:.9rem}
.bar select{border:1px solid var(--line);background:var(--bg);border-radius:6px;padding:5px 8px}
.bar input[type=range]{width:150px;accent-color:var(--accent)}
.bar .count{margin-left:auto;color:var(--muted);font-size:.9rem}

/* product card */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:12px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;min-width:0}
.tw{position:relative}
.thumb{display:block;width:100%;padding:0;border:0;background:none}
.thumb svg{display:block;width:100%;height:auto}
.badge{position:absolute;left:8px;top:8px;background:var(--sale);color:#fff;font-weight:700;font-size:.75rem;border-radius:5px;padding:1px 7px}
.heart{position:absolute;right:8px;top:8px;width:32px;height:32px;border-radius:50%;border:0;background:rgba(255,255,255,.88);display:grid;place-items:center;color:#38494d}
.heart svg{width:17px;height:17px}
.heart[aria-pressed="true"]{color:#D6336C}
.heart[aria-pressed="true"] path{fill:currentColor}
.cbody{padding:10px 12px 12px;display:flex;flex-direction:column;gap:4px;flex:1}
.cname{background:none;border:0;padding:0;text-align:left;font-weight:500;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em}
.price{font:800 1.15rem var(--display);color:var(--accent)}
.was{color:var(--muted);font-size:.82rem;text-decoration:line-through;margin-left:6px;font-weight:400;font-family:var(--body)}
.meta{color:var(--muted);font-size:.8rem}
.meta .star{color:#C98600}
.add{margin-top:auto;border:1.5px solid var(--accent);background:transparent;color:var(--accent);border-radius:7px;padding:6px;font-weight:700}
.add:hover{background:var(--accent);color:var(--accent-ink)}
.empty{grid-column:1/-1;text-align:center;padding:48px 16px;color:var(--muted);background:var(--surface);border:1px dashed var(--line);border-radius:10px}
.empty h3{color:var(--ink);font:700 1.1rem var(--display);margin-bottom:6px}

/* footer */
footer{margin-top:36px;background:var(--surface);border-top:1px solid var(--line);padding-block:26px 34px;color:var(--muted);font-size:.9rem}
footer .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px}
footer h3{font:700 .95rem var(--display);color:var(--ink);margin-bottom:6px}
footer .demo{margin-top:20px;padding-top:14px;border-top:1px solid var(--line);font-size:.82rem}

/* overlays */
.scrim{position:fixed;inset:0;background:rgba(5,20,22,.55);z-index:40}
.drawer{position:fixed;top:0;bottom:0;right:0;width:min(440px,100%);background:var(--surface);z-index:50;display:flex;flex-direction:column;box-shadow:var(--shadow);padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);padding-right:env(safe-area-inset-right,0px)}
.dh{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}
.dh h2{font-size:1.2rem}
.x{border:0;background:var(--chip);width:34px;height:34px;border-radius:50%;font-size:1.2rem;line-height:1}
.dbody{flex:1;overflow-y:auto;padding:14px 18px}
.dfoot{border-top:1px solid var(--line);padding:14px 18px;display:grid;gap:10px}
.line-item{display:grid;grid-template-columns:64px 1fr;gap:12px;padding-block:10px;border-bottom:1px solid var(--line)}
.line-item svg{width:64px;height:64px;border-radius:8px}
.line-item h3{font:500 .92rem var(--body);line-height:1.3}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.qty{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:7px}
.qty button{border:0;background:none;width:30px;height:30px;font-size:1.1rem}
.qty span{min-width:28px;text-align:center}
.link{background:none;border:0;color:var(--muted);text-decoration:underline;padding:0;font-size:.85rem}
.sum{display:grid;gap:4px;font-size:.92rem}
.sum .total{font:800 1.15rem var(--display);padding-top:6px;border-top:1px solid var(--line)}
.free{color:var(--accent);font-weight:700}
form.co{display:flex;flex-direction:column;flex:1;min-height:0}
.fld{display:grid;gap:4px}
.fld label,.fld legend{font-weight:500;font-size:.88rem}
.fld input,.fld select{border:1px solid var(--line);background:var(--bg);border-radius:7px;padding:9px 10px;width:100%}
.fld .err{color:var(--sale);font-size:.8rem;min-height:1em}
fieldset{border:0;padding:0;margin:0}
.pay{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
.pay label{display:flex;gap:8px;align-items:center;border:1px solid var(--line);border-radius:7px;padding:8px 10px;font-weight:400}
.pay input{width:auto;accent-color:var(--accent)}
.pay label:has(input:checked){border-color:var(--accent);background:var(--chip)}
.drawer.wide{width:min(620px,100%)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.stats div{background:var(--bg);border-radius:10px;padding:10px 12px;min-width:0}
.stats b{display:block;font:800 1.3rem var(--display);overflow-wrap:anywhere}
.stats span{color:var(--muted);font-size:.8rem}
.ord{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:10px;display:grid;gap:6px;min-width:0}
.ord select{border:1px solid var(--line);background:var(--bg);border-radius:6px;padding:4px 8px}
.ord ul{margin:0;padding-left:18px;font-size:.9rem}
.ord p{margin:0;overflow-wrap:anywhere}
.pimg{display:block;width:100%;aspect-ratio:1/1;object-fit:cover}
.line-item .pimg{width:64px;height:64px;border-radius:8px}
.m-art .pimg{height:100%;min-height:260px;aspect-ratio:auto}
.tabs{display:flex;gap:8px;margin-bottom:14px}
.prow{display:grid;grid-template-columns:72px 1fr;gap:10px 12px;border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:10px;min-width:0}
.prow svg,.prow .pimg{width:72px;height:72px;border-radius:8px}
.prow input[type=text],.prow input[type=number],.prow select{border:1px solid var(--line);background:var(--bg);border-radius:6px;padding:6px 8px;width:100%;min-width:0}
.pf{display:grid;grid-template-columns:1fr 1fr;gap:8px;grid-column:1/-1}
.pf label{display:grid;gap:2px;font-size:.78rem;color:var(--muted);font-weight:400;min-width:0}
.pbtn{display:flex;gap:12px;flex-wrap:wrap;align-items:center;grid-column:1/-1}
.sm{padding:6px 12px;font-size:.85rem}
.vh{position:absolute;opacity:0;width:1px;height:1px;overflow:hidden}
label.btn{cursor:pointer}
label.btn:has(.vh:focus-visible){outline:3px solid var(--accent);outline-offset:2px}
@media (max-width:640px){.m-art .pimg{min-height:0;aspect-ratio:16/10}}
.m-art{display:flex;flex-direction:column;background:var(--bg);min-width:0}
.m-art .main{flex:1;width:100%;height:auto;min-height:260px;aspect-ratio:auto;object-fit:cover;display:block}
@media (max-width:640px){.m-art .main{flex:none;min-height:0;aspect-ratio:1/1}}
.m-rev{border-top:1px solid var(--line);padding:18px 22px 22px;display:grid;gap:12px}
.m-rev h3{font:800 1.1rem var(--display)}
.rlist{display:grid;gap:10px;max-height:320px;overflow-y:auto}
.rv{border-bottom:1px solid var(--line);padding-bottom:10px;display:grid;gap:2px;min-width:0}
.rv .st{color:#C98600;letter-spacing:2px}
.rv p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}
.vp{color:var(--accent);font-size:.78rem;font-weight:700}
.rform{display:grid;gap:8px;background:var(--bg);border-radius:10px;padding:14px}
.rform textarea{width:100%;min-height:80px;border:1px solid var(--line);background:var(--surface);border-radius:7px;padding:9px 10px;resize:vertical}
.starpick{display:flex;gap:2px}
.rpics{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.rpics .pth img{border-radius:8px}
.rimgs{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}
.rimg{padding:0;border:1px solid var(--line);border-radius:8px;overflow:hidden;width:64px;height:64px;background:none}
.rimg img{width:100%;height:100%;object-fit:cover;display:block}
#lb{position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.88);display:grid;place-items:center;padding:16px;cursor:zoom-out}
#lb img{max-width:100%;max-height:100%;object-fit:contain;border-radius:8px}
.starpick button{border:0;background:none;font-size:2rem;color:#C98600;padding:0 2px;line-height:1}
.gth{display:flex;gap:6px;padding:8px;overflow-x:auto;background:var(--surface)}
.gth button{flex:none;width:56px;height:56px;padding:0;border:2px solid transparent;border-radius:8px;overflow:hidden;background:none}
.gth button[aria-current="true"]{border-color:var(--accent)}
.gth img{width:100%;height:100%;object-fit:cover;display:block}
.pimgs{display:flex;gap:10px;flex-wrap:wrap;grid-column:1/-1}
.pth{position:relative;width:64px;height:64px}
.pth .cv{display:block;width:100%;height:100%;padding:0;border:2px solid var(--line);border-radius:8px;overflow:hidden;background:none}
.pth.first .cv{border-color:var(--accent)}
.pth img{width:100%;height:100%;object-fit:cover;display:block}
.pth .tag{position:absolute;left:0;right:0;bottom:0;background:var(--accent);color:var(--accent-ink);font-size:.62rem;text-align:center;border-radius:0 0 6px 6px;pointer-events:none}
.pth .rm{position:absolute;right:-7px;top:-7px;width:22px;height:22px;border-radius:50%;border:0;background:var(--sale);color:#fff;line-height:1;font-size:14px;padding:0}
.done{text-align:center;padding:26px 6px}
.done .ok{width:64px;height:64px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;margin:0 auto 14px;font-size:2rem}
.done h2{font-size:1.5rem;margin-bottom:6px}
.done dl{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;text-align:left;background:var(--bg);border-radius:10px;padding:14px;margin:16px 0}
.done dt{color:var(--muted)}.done dd{margin:0;overflow-wrap:anywhere}

.modal{position:fixed;z-index:50;left:50%;top:50%;transform:translate(-50%,-50%);width:min(780px,calc(100% - 24px));max-height:calc(100% - 24px);overflow-y:auto;background:var(--surface);border-radius:14px;box-shadow:var(--shadow)}
.m-in{display:grid;grid-template-columns:1fr 1fr;gap:0}
.m-art svg{display:block;width:100%;height:100%;min-height:260px;object-fit:cover}
.m-info{padding:22px;display:grid;gap:10px;align-content:start;min-width:0}
.m-info h2{font-size:1.4rem;line-height:1.15}
.m-info .price{font-size:1.7rem}
.m-info p{color:var(--muted)}
.m-info ul{margin:0;padding-left:18px;color:var(--muted);font-size:.9rem}
.m-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:4px}
.m-close{position:absolute;right:10px;top:10px;z-index:2}
@media (max-width:640px){.m-in{grid-template-columns:1fr}.m-art svg{min-height:0;aspect-ratio:16/10}}

#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:8px;z-index:60;font-weight:500;max-width:calc(100% - 32px)}
@media (prefers-reduced-motion:no-preference){.card,.cat,.btn{transition:box-shadow .15s,transform .15s}.card:hover,.cat:hover{box-shadow:0 6px 20px rgba(10,40,40,.12);transform:translateY(-2px)}}

.stk{font-size:.78rem;color:var(--muted)}.stk.low{color:#B45309;font-weight:600}.stk.out{color:var(--sale);font-weight:700}
.opt{display:grid;gap:4px}.crow{display:flex;gap:6px;flex-wrap:wrap}.crow .chip{padding:5px 14px}
.m-info .pdesc{white-space:pre-wrap;color:var(--fg)}
.cpn{display:flex;gap:8px}.cpn input{flex:1;min-width:0;border:1px solid var(--line);background:var(--bg);border-radius:7px;padding:8px 10px;text-transform:uppercase}
#newPin{text-transform:none}
.sh{font:700 1rem var(--display);margin:18px 0 8px}
.set{grid-template-columns:1fr}
.pf label,.srow label,.dgrid label{display:grid;gap:3px;font-size:.78rem;color:var(--muted)}
.pf input,.pf select,.pf textarea,.srow input,.srow select,.dgrid input,.prow textarea,.cpn input{border:1px solid var(--line);background:var(--bg);color:var(--fg);border-radius:7px;padding:7px 9px;width:100%;font:inherit}
.prow textarea,.fld textarea{border:1px solid var(--line);background:var(--bg);color:var(--fg);border-radius:7px;padding:8px 10px;width:100%;font:inherit;resize:vertical}
.dist{margin:10px 0;border:1px solid var(--line);border-radius:8px;padding:8px 10px}.dist summary{cursor:pointer;font-weight:600}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin-top:8px}
.srow{display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:8px;align-items:end;border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:8px}
.inv{display:grid;gap:12px;border:1px solid var(--line);border-radius:10px;padding:14px;background:var(--bg)}
