const qtyIn=pid=>lines().filter(l=>l.p.id===pid).reduce((s,l)=>s+l.q,0);
function discountFor(sub){
  const c=findCoupon(couponCode);if(!c||sub<(+c.min||0))return 0;
  return c.type==='flat'?Math.min(+c.value||0,sub):Math.floor(sub*Math.min(100,+c.value||0)/100);
}
function totals(d){
  const sub=subtotal(),disc=discountFor(sub),net=sub-disc,fo=+settings.delivery.freeOver||0;
  const fee=!sub?0:(fo>0&&net>=fo?0:feeFor(d||'Dhaka'));
  return{sub,disc,net,fee,total:net+fee,freeShip:!!sub&&fo>0&&net>=fo};
}
function addToCart(p,n,v){
  if(p.stock!=null){
    if(p.stock<=0){toast('Out of stock');return false}
    if(qtyIn(p.id)+n>p.stock){toast(`Only ${p.stock} in stock`);return false}
  }
  const k=v?`${p.id}|${v}`:`${p.id}`;
  cart[k]=(cart[k]||0)+n;persist();renderCounts();return true;
}
function setStatus(o,s){
  const was=o.status;o.status=s;
  if(s==='Cancelled'&&was!=='Cancelled'&&!o.stockBack){
    for(const l of o.lines||[]){const p=byId[l.id];if(p&&p.stock!=null)p.stock+=l.q}
    o.stockBack=true;saveProducts();
  }else if(was==='Cancelled'&&s!=='Cancelled'&&o.stockBack){
    for(const l of o.lines||[]){const p=byId[l.id];if(p&&p.stock!=null)p.stock=Math.max(0,p.stock-l.q)}
    o.stockBack=false;saveProducts();
  }
}
