document.addEventListener('submit',e=>{
  const id=e.target.id;
  if(id==='searchForm'){e.preventDefault();f.q=$('#q').value.trim().toLowerCase();f.cat='all';f.saved=false;refresh();goShop();return}
  if(id==='trackForm'){e.preventDefault();trackQ={id:$('#tId').value,phone:$('#tPhone').value};if(!trackQ.id.trim()||!trackQ.phone.trim()){toast('Enter the order number and phone');return}doTrack();renderDrawer();return}
  if(id==='pinForm'){
    e.preventDefault();
    const p1=$('#pin1').value,has=!!getPin();
    (async()=>{
      if(has){if(await hashPin(p1)===getPin()){unlocked=true;pinErr='';step='admin';renderDrawer()}else{pinErr='Wrong PIN. Try again.';renderPin($('#drawer'));$('#pin1').focus()}return}
      if(!/^\d{4,8}$/.test(p1)){pinErr='The PIN must be 4 to 8 digits.';renderPin($('#drawer'));return}
      if(p1!==$('#pin2').value){pinErr='PINs do not match.';renderPin($('#drawer'));return}
      try{localStorage.setItem('haat-pin',await hashPin(p1))}catch(err){}
      unlocked=true;pinErr='';step='admin';renderDrawer();
    })();
    return;
  }
  if(id!=='coForm')return;
  e.preventDefault();
  const fd=new FormData(e.target),v=Object.fromEntries(fd.entries());
  const errs={cName:!v.name.trim()&&'Enter your full name.',cPhone:!/^01[3-9]\d{8}$/.test(v.phone.replace(/[\s-]/g,''))&&'Enter an 11-digit mobile number starting with 01.',cAddr:!v.addr.trim()&&'Enter your delivery address.'};
  let bad=false;
  document.querySelectorAll('.err').forEach(s=>{const m=errs[s.dataset.for];s.textContent=m||'';if(m&&!bad){bad=true;document.getElementById(s.dataset.for).focus()}});
  if(bad)return;
  const L=lines();
  for(const l of L){if(l.p.stock!=null&&qtyIn(l.p.id)>l.p.stock){toast(`Only ${l.p.stock} in stock for ${l.p.name}`);return}}
  const T=totals(v.district);
  order={id:'HT-'+String(Math.floor(100000+Math.random()*900000)),name:v.name.trim(),phone:v.phone.replace(/[\s-]/g,''),district:v.district,addr:v.addr.trim(),pay:v.pay,items:itemCount(),
    sub:T.sub,disc:T.disc,coupon:T.disc?couponCode.toUpperCase():'',fee:T.fee,total:T.total,
    lines:L.map(l=>({id:l.p.id,name:l.p.name,v:l.v,q:l.q,price:l.p.price})),at:Date.now(),status:'Pending',stockBack:false};
  for(const l of L){if(l.p.stock!=null)l.p.stock=Math.max(0,l.p.stock-l.q)}
  saveProducts();
  orders.unshift(order);saveOrders();
  cart={};couponCode='';persist();refresh();step='done';renderDrawer();
});

