  else if(a==='sreset'){settings.site=siteDef();saveSettings();applySite();keepScroll();toast('Saved.')}
  else if(a==='cadd'){settings.coupons.push({code:'NEW10',type:'percent',value:10,min:0,on:true});saveSettings();keepScroll()}
