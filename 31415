async function hashPin(pin){
  const txt='haat|'+pin;
  try{if(window.crypto&&crypto.subtle){const h=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(txt));return [...new Uint8Array(h)].map(b=>b.toString(16).padStart(2,'0')).join('')}}catch(e){}
  let x=5381;for(const c of txt)x=((x<<5)+x+c.charCodeAt(0))|0;return 'f'+x;
}
